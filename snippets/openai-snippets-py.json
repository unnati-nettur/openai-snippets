  "Upload File and Use as Input": {
    "prefix": "openai-upload-file-input",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "uploaded_file = openai_client.files.create(file=open('sample_document.pdf', 'rb'), purpose='user_data')",
