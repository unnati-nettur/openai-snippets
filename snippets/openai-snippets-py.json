  "Generate Response from Simple Prompt": {
    "prefix": "openai-response-simple-prompt",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    input='Compose a cheerful haiku about the morning sun.'",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Generate a response from a simple text prompt"
  },
  "Generate Response with Instructions": {
    "prefix": "openai-response-instructions",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    reasoning={'effort': 'low'},",
      "    instructions='Explain it as if you are a friendly teacher.',",
      "    input='What are Python decorators and how are they used?'",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Generate a response with custom instructions"
  },
  "Generate Response with Multiple Roles": {
    "prefix": "openai-response-multi-role",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    reasoning={'effort': 'low'},",
      "    input=[",
      "        {'role': 'developer', 'content': 'Answer in the style of a supportive mentor.'},",
      "        {'role': 'user', 'content': 'Can you explain the difference between lists and tuples in Python?'}",
      "    ]",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Generate a response using multiple roles"
  },
  "Generate Response with Prompt Template": {
    "prefix": "openai-response-prompt-template",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    prompt={",
      "        'id': 'template_welcome_msg_001',",
      "        'version': '1',",
      "        'variables': {",
      "            'student_name': 'Alex Johnson',",
      "            'course_title': 'Introduction to Machine Learning'",
      "        }",
      "    }",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Generate a response using a predefined prompt template"
  },
  "Prompt Template with File Input": {
    "prefix": "openai-response-prompt-file",
    "body": [
      "import openai, pathlib",
      "",
      "openai_client = openai.OpenAI()",
      "",
      "uploaded_file = openai_client.files.create(file=open('research_notes.pdf', 'rb'), purpose='user_data')",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    prompt={",
      "        'id': 'template_research_summary_001',",
      "        'variables': {",
      "            'topic': 'Neural Networks',",
      "            'reference_doc': {'type': 'input_file', 'file_id': uploaded_file.id}",
      "        }",
      "    }",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Generate a response using a prompt template with a file input"
  },
  "Analyze Image Content": {
    "prefix": "openai-response-analyze-image",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    input=[",
      "        {",
      "            'role': 'user',",
      "            'content': [",
      "                {'type': 'input_text', 'text': 'What landmark is shown in this photo?'},",
      "                {'type': 'input_image', 'image_url': 'https://upload.wikimedia.org/wikipedia/commons/a/a1/Eiffel_Tower_in_Paris_2020.jpg'}",
      "            ]",
      "        }",
      "    ]",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Analyze an image and generate a response"
  },
