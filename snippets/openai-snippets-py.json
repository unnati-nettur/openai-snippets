  "Use Web Search in a Response": {
    "prefix": "openai-web-search-response",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    tools=[{'type': 'web_search'}],",
      "    input='Find a recent uplifting news story from today.'",
      ")",
      "",
      "print(openai_response.output_text)"
    ],
    "description": "Use OpenAI's web search tool to generate a response"
  },
  "Search Your Files in a Response": {
    "prefix": "openai-file-search-response",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "openai_response = openai_client.responses.create(",
      "    model='gpt-4.1',",
      "    input='Explain the concept of advanced AI research in simple terms.',",
      "    tools=[{'type': 'file_search', 'vector_store_ids': ['<your_vector_store_id_here>']}]",
      ")",
      "",
      "print(openai_response)"
    ],
    "description": "Search a vector store of files to generate a response"
  },
  "Call Your Own Function": {
    "prefix": "openai-call-function",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "weather_tool = [",
      "    {",
      "        'type': 'function',",
      "        'name': 'get_weather',",
      "        'description': 'Retrieve the current temperature for a specified location.',",
      "        'parameters': {",
      "            'type': 'object',",
      "            'properties': {",
      "                'location': {'type': 'string', 'description': 'City and country, e.g., Tokyo, Japan'}",
      "            },",
      "            'required': ['location'],",
      "            'additionalProperties': False",
      "        },",
      "        'strict': True",
      "    }",
      "]",
      "",
      "weather_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    input=[{'role': 'user', 'content': 'What is the weather like in Sydney today?'}],",
      "    tools=weather_tool",
      ")",
      "",
      "print(weather_response.output[0].to_json())"
    ],
    "description": "Call a custom function via the OpenAI Responses API"
  },
  "Call a Remote MCP Server": {
    "prefix": "openai-call-mcp-server",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "dnd_tool = [",
      "    {",
      "        'type': 'mcp',",
      "        'server_label': 'dnd_mcp',",
      "        'server_description': 'A Dungeons & Dragons MCP server to assist with character actions and storytelling.',",
      "        'server_url': 'https://dnd-mcp-server.example.com/sse',",
      "        'require_approval': 'never'",
      "    }",
      "]",
      "",
      "dnd_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    tools=dnd_tool,",
      "    input='Attempt to pick the lock on the treasure chest'",
      ")",
      "",
      "print(dnd_response.output_text)"
    ],
    "description": "Call a remote MCP server to handle tasks or simulations"
  },
  "Stream Server-Sent Events from the API": {
    "prefix": "openai-stream-server-events",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "streamed_response = openai_client.responses.create(",
      "    model='gpt-5',",
      "    input=[{'role': 'user', 'content': \"Quickly recite the phrase 'Hello World' five times.\"}],",
      "    stream=True",
      ")",
      "",
      "for event in streamed_response:",
      "    print(event)"
    ],
    "description": "Stream server-sent events from OpenAI Responses API"
  },
  "Build a Language Triage Agent": {
    "prefix": "openai-build-agent",
    "body": [
      "from agents import Agent, Runner",
      "import asyncio",
      "",
      "french_agent = Agent(",
      "    name='French Agent',",
      "    instructions='You only speak French.'",
      ")",
      "",
      "german_agent = Agent(",
      "    name='German Agent',",
      "    instructions='You only speak German.'",
      ")",
      "",
      "language_triage_agent = Agent(",
      "    name='Language Triage Agent',",
      "    instructions='Handoff the request to the correct agent based on the language detected.',",
      "    handoffs=[french_agent, german_agent],",
      ")",
      "",
      "async def main():",
      "    result = await Runner.run(language_triage_agent, input='Bonjour, comment ça va?')",
      "    print(result.final_output)",
      "",
      "if __name__ == '__main__':",
      "    asyncio.run(main())"
    ],
    "description": "Create a language triage agent that delegates requests to specific language agents"
  },
  "Generate Images with Responses": {
    "prefix": "openai-generate-image-response",
    "body": [
      "from openai import OpenAI",
      "import base64",
      "",
      "openai_client = OpenAI()",
      "",
      "image_response = openai_client.responses.create(",
      "    model='gpt-4.1-mini',",
      "    input='Generate an image of a golden retriever puppy playing with a red ball',",
      "    tools=[{'type': 'image_generation'}],",
      ")",
      "",
      "generated_images = [output.result for output in image_response.output if output.type == 'image_generation_call']",
      "",
      "if generated_images:",
      "    image_base64 = generated_images[0]",
      "    with open('puppy_and_ball.png', 'wb') as f:",
      "        f.write(base64.b64decode(image_base64))"
    ],
    "description": "Generate an image using OpenAI Responses API"
  },
  "Create Human-Like Audio Response": {
    "prefix": "openai-create-audio-response",
    "body": [
      "import base64",
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "audio_response = openai_client.chat.completions.create(",
      "    model='gpt-4o-audio-preview',",
      "    modalities=['text', 'audio'],",
      "    audio={'voice': 'alloy', 'format': 'wav'},",
      "    messages=[{'role': 'user', 'content': 'Can a Siberian Husky be a good companion for families?'}]",
      ")",
      "",
      "print(audio_response.choices[0])",
      "",
      "wav_bytes = base64.b64decode(audio_response.choices[0].message.audio.data)",
      "with open('husky_companion.wav', 'wb') as audio_file:",
      "    audio_file.write(wav_bytes)"
    ],
    "description": "Generate human-like audio output from a text prompt"
  },
  "Getting a Structured Response": {
    "prefix": "openai-structured-response",
    "body": [
      "from openai import OpenAI",
      "from pydantic import BaseModel",
      "",
      "openai_client = OpenAI()",
      "",
      "class CalendarEvent(BaseModel):",
      "    title: str",
      "    date: str",
      "    participants: list[str]",
      "",
      "event_response = openai_client.responses.parse(",
      "    model='gpt-4o-2024-08-06',",
      "    input=[",
      "        {'role': 'system', 'content': 'Extract event details from the message.'},",
      "        {'role': 'user', 'content': 'Charlie and Dana will attend a robotics workshop next Tuesday.'},",
      "    ],",
      "    text_format=CalendarEvent,",
      ")",
      "",
      "parsed_event = event_response.output_parsed"
    ],
    "description": "Parse structured event details from text using OpenAI"
  },
  "Extract Data from Research Paper": {
    "prefix": "openai-structured-response-document",
    "body": [
      "from openai import OpenAI",
      "from pydantic import BaseModel",
      "",
      "openai_client = OpenAI()",
      "",
      "class ResearchPaperStructured(BaseModel):",
      "    title: str",
      "    authors: list[str]",
      "    abstract: str",
      "    keywords: list[str]",
      "",
      "structured_response = openai_client.responses.parse(",
      "    model='gpt-4o-2024-08-06',",
      "    input=[",
      "        {'role': 'system', 'content': (",
      "            'You are an expert in structured data extraction. '",
      "            'Given unstructured text from a research paper, convert it into the following structure.'",
      "        )},",
      "        {'role': 'user', 'content': (",
      "            'Recent advances in quantum computing have shown significant improvements in error correction. '",
      "            'This paper explores the implementation of fault-tolerant algorithms on superconducting qubits...'",
      "        )},",
      "    ],",
      "    text_format=ResearchPaperStructured,",
      ")",
      "",
      "parsed_paper = structured_response.output_parsed"
    ],
    "description": "Extract structured information from research papers using OpenAI Responses API"
  },
  "Generating HTML using Structured Outputs": {
    "prefix": "openai-generate-structured-html",
    "body": [
      "from enum import Enum",
      "from typing import List",
      "from openai import OpenAI",
      "from pydantic import BaseModel",
      "",
      "openai_client = OpenAI()",
      "",
      "class UIElementType(str, Enum):",
      "    div = 'div'",
      "    button = 'button'",
      "    header = 'header'",
      "    section = 'section'",
      "    field = 'field'",
      "    form = 'form'",
      "",
      "class UIAttribute(BaseModel):",
      "    name: str",
      "    value: str",
      "",
      "class UIElement(BaseModel):",
      "    type: UIElementType",
      "    label: str",
      "    children: List['UIElement']",
      "    attributes: List[UIAttribute]",
      "",
      "UIElement.model_rebuild()",
      "",
      "class UIResponse(BaseModel):",
      "    ui: UIElement",
      "",
      "ui_response = openai_client.responses.parse(",
      "    model='gpt-4o-2024-08-06',",
      "    input=[",
      "        {'role': 'system', 'content': 'You are a UI generator AI. Convert user input into a structured UI representation.'},",
      "        {'role': 'user', 'content': 'Create a Registration Form with Name, Email, and Password fields'},",
      "    ],",
      "    text_format=UIResponse,",
      ")",
      "",
      "parsed_ui = ui_response.output_parsed"
    ],
    "description": "Generate structured HTML UI output using OpenAI Responses API"
  },
  "Structured Outputs for Chain-of-Thought Math Tutoring": {
    "prefix": "openai-structured-chainofthought",
    "body": [
      "from openai import OpenAI",
      "from pydantic import BaseModel",
      "",
      "openai_client = OpenAI()",
      "",
      "class ReasoningStep(BaseModel):",
      "    explanation: str",
      "    output: str",
      "",
      "class StepByStepMath(BaseModel):",
      "    steps: list[ReasoningStep]",
      "    final_answer: str",
      "",
      "math_response = openai_client.responses.parse(",
      "    model='gpt-4o-2024-08-06',",
      "    input=[",
      "        {'role': 'system', 'content': 'You are a helpful math tutor. Guide the user through solving the problem step by step.'},",
      "        {'role': 'user', 'content': 'Solve for y: 5y - 9 = 16'},",
      "    ],",
      "    text_format=StepByStepMath,",
      ")",
      "",
      "parsed_math = math_response.output_parsed"
    ],
    "description": "Provide step-by-step math tutoring with structured outputs"
  },
  "Use the Responses API with Code Interpreter": {
    "prefix": "openai-responses-code-interpreter",
    "body": [
      "from openai import OpenAI",
      "",
      "openai_client = OpenAI()",
      "",
      "tutor_instructions = '''",
      "You are a personal math tutor. When given a math problem,",
      "write and execute Python code using the code interpreter tool to solve it.",
      "'''",
      "",
      "math_response = openai_client.responses.create(",
      "    model='gpt-4.1',",
      "    tools=[{'type': 'code_interpreter', 'container': {'type': 'auto'}}],",
      "    instructions=tutor_instructions,",
      "    input='Please solve for x: 7x - 5 = 23'",
      ")",
      "",
      "print(math_response.output)"
    ],
    "description": "Solve math problems using the Responses API with code interpreter"
  }
}
